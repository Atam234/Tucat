# Kopyahin ito bilang .env — HUWAG i-commit ang .env.
# Kung walang key, tatakbo ang app sa "demo mode" (simple keyword planner, walang LLM).
OPENROUTER_API_KEY=

# Murang default model + fallbacks (OpenRouter ang pipili ng susunod kapag down ang una)
LLM_MODEL=google/gemini-2.5-flash
LLM_FALLBACK_MODELS=openai/gpt-4o-mini,anthropic/claude-haiku-4.5
LLM_MAX_TOKENS=1200
AGENT_MAX_STEPS=8

# Kontrol sa gastos (server-side; bukod pa sa hard limit sa OpenRouter dashboard)
MONTHLY_BUDGET_USD=15
CHAT_PER_MINUTE=6
CHAT_PER_DAY=20
UPLOADS_PER_DAY=10
RENDERS_PER_DAY=10

MAX_UPLOAD_MB=500
MAX_VIDEO_MINUTES=30
PORT=3000
# Itakda sa 1 kapag nasa likod ng proxy (Render, Fly, Railway, Nginx) para tama ang IP sa rate limit
TRUST_PROXY=0
# Dagdag na web origins na pwedeng tumawag sa API (comma-separated). Kasama na by default ang origins ng mobile app.
ALLOWED_ORIGINS=
